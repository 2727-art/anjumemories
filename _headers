# Keep the entry HTML fresh so new version query strings are picked up.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Versioned source files. Bump the ?v= value in index.html when these change.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/画像/*
  Cache-Control: public, max-age=31536000, immutable

/音声/*
  Cache-Control: public, max-age=31536000, immutable
