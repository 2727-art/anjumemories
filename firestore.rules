rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboardKills/{entryId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "name",
          "kills",
          "survivalTimeMs",
          "level",
          "eliteKills",
          "maxDepthReached",
          "bestDepth",
          "extractedGeek",
          "extractMode",
          "extractionSucceeded",
          "anjuMemoryEarned",
          "selectedTitle",
          "selectedBadge",
          "submittedAt",
          "version",
          "uid",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 100000
        && request.resource.data.survivalTimeMs is int
        && request.resource.data.survivalTimeMs >= 0
        && request.resource.data.survivalTimeMs <= 86400000
        && request.resource.data.level is int
        && request.resource.data.level >= 0
        && request.resource.data.level <= 999
        && request.resource.data.eliteKills is int
        && request.resource.data.eliteKills >= 0
        && request.resource.data.eliteKills <= 100000
        && (!request.resource.data.keys().hasAny(["maxDepthReached"])
          || (request.resource.data.maxDepthReached is int
            && request.resource.data.maxDepthReached >= 1
            && request.resource.data.maxDepthReached <= 999))
        && (!request.resource.data.keys().hasAny(["bestDepth"])
          || (request.resource.data.bestDepth is int
            && request.resource.data.bestDepth >= 1
            && request.resource.data.bestDepth <= 999))
        && (!request.resource.data.keys().hasAny(["extractedGeek"])
          || (request.resource.data.extractedGeek is int
            && request.resource.data.extractedGeek >= 0
            && request.resource.data.extractedGeek <= 1000000000))
        && (!request.resource.data.keys().hasAny(["extractMode"])
          || (request.resource.data.extractMode is string
            && request.resource.data.extractMode in ["none", "normal", "emergency"]))
        && (!request.resource.data.keys().hasAny(["extractionSucceeded"])
          || request.resource.data.extractionSucceeded is bool)
        && (!request.resource.data.keys().hasAny(["anjuMemoryEarned"])
          || (request.resource.data.anjuMemoryEarned is int
            && request.resource.data.anjuMemoryEarned >= 0
            && request.resource.data.anjuMemoryEarned <= 100000))
        && (!request.resource.data.keys().hasAny(["selectedTitle"])
          || (request.resource.data.selectedTitle is string
            && request.resource.data.selectedTitle.size() <= 32))
        && (!request.resource.data.keys().hasAny(["selectedBadge"])
          || (request.resource.data.selectedBadge is string
            && request.resource.data.selectedBadge.size() <= 12))
        && (!request.resource.data.keys().hasAny(["submittedAt"])
          || (request.resource.data.submittedAt is int
            && request.resource.data.submittedAt >= 0))
        && (!request.resource.data.keys().hasAny(["version"])
          || (request.resource.data.version is int
            && request.resource.data.version >= 1
            && request.resource.data.version <= 10))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
