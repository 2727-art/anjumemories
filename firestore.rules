rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleSaveOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isValidCloudSaveRootMetadata(data) {
      return (data.schemaVersion == 1 && data.keys().hasOnly([
          "schemaVersion", "revision", "clientUpdatedAt", "updatedAt"
        ])) || (data.schemaVersion == 2 && data.keys().hasOnly([
          "schemaVersion", "revision", "clientUpdatedAt", "updatedAt", "minWriterVersion", "requiredCapabilities"
        ]) && data.minWriterVersion == 2
        && data.requiredCapabilities is list
        && data.requiredCapabilities.size() == 4
        && data.requiredCapabilities.hasAll([
          "umbra-owned-v1", "umbra-atlas-v1", "umbra-archive-v2", "progression-journal-v1"
        ]));
    }

    function cloudSaveSegmentsMatchAfter(userId, revision, schemaVersion) {
      let core = getAfter(
        /databases/$(database)/documents/playerCloudSaves/$(userId)/segments/core
      ).data;
      let equipment = getAfter(
        /databases/$(database)/documents/playerCloudSaves/$(userId)/segments/equipment
      ).data;
      let archive = getAfter(
        /databases/$(database)/documents/playerCloudSaves/$(userId)/segments/archive
      ).data;
      return core.schemaVersion == schemaVersion
        && core.revision == revision
        && core.updatedAt == request.time
        && equipment.schemaVersion == schemaVersion
        && equipment.revision == revision
        && equipment.updatedAt == request.time
        && archive.schemaVersion == schemaVersion
        && archive.revision == revision
        && archive.updatedAt == request.time;
    }

    function isValidCloudSaveRootCreate(userId) {
      return isValidCloudSaveRootMetadata(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.clientUpdatedAt >= 0
        && request.resource.data.updatedAt == request.time
        && cloudSaveSegmentsMatchAfter(userId, 1, request.resource.data.schemaVersion);
    }

    function isValidCloudSaveRootUpdate(userId) {
      return isValidCloudSaveRootMetadata(request.resource.data)
        && resource.data.schemaVersion in [1, 2]
        && request.resource.data.schemaVersion >= resource.data.schemaVersion
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.clientUpdatedAt >= 0
        && request.resource.data.updatedAt == request.time
        && cloudSaveSegmentsMatchAfter(userId, request.resource.data.revision, request.resource.data.schemaVersion);
    }

    function isValidCloudSaveSegmentData(segmentId) {
      return segmentId in ["core", "equipment", "archive"]
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "revision",
          "data",
          "updatedAt"
        ])
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time;
    }

    function isValidCloudSaveSegmentCreate(userId, segmentId) {
      let rootAfter = getAfter(
        /databases/$(database)/documents/playerCloudSaves/$(userId)
      ).data;
      return isValidCloudSaveSegmentData(segmentId)
        && request.resource.data.revision == 1
        && !exists(/databases/$(database)/documents/playerCloudSaves/$(userId))
        && rootAfter.schemaVersion == request.resource.data.schemaVersion
        && rootAfter.revision == 1
        && rootAfter.updatedAt == request.time;
    }

    function isValidCloudSaveSegmentUpdate(userId, segmentId) {
      let rootBefore = get(
        /databases/$(database)/documents/playerCloudSaves/$(userId)
      ).data;
      let rootAfter = getAfter(
        /databases/$(database)/documents/playerCloudSaves/$(userId)
      ).data;
      return isValidCloudSaveSegmentData(segmentId)
        && resource.data.schemaVersion in [1, 2]
        && request.resource.data.revision == resource.data.revision + 1
        && rootBefore.schemaVersion == resource.data.schemaVersion
        && rootAfter.schemaVersion == request.resource.data.schemaVersion
        && rootAfter.schemaVersion >= rootBefore.schemaVersion
        && rootAfter.revision == rootBefore.revision + 1
        && request.resource.data.revision == rootAfter.revision
        && rootAfter.updatedAt == request.time;
    }

    match /playerCloudSaves/{userId} {
      allow read: if isGoogleSaveOwner(userId);
      allow create: if isGoogleSaveOwner(userId) && isValidCloudSaveRootCreate(userId);
      allow update: if isGoogleSaveOwner(userId) && isValidCloudSaveRootUpdate(userId);
      allow delete: if false;

      match /segments/{segmentId} {
        allow read: if isGoogleSaveOwner(userId)
          && segmentId in ["core", "equipment", "archive"];
        allow create: if isGoogleSaveOwner(userId)
          && isValidCloudSaveSegmentCreate(userId, segmentId);
        allow update: if isGoogleSaveOwner(userId)
          && isValidCloudSaveSegmentUpdate(userId, segmentId);
        allow delete: if false;
      }
    }

    match /leaderboardKills/{entryId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "name",
          "kills",
          "survivalTimeMs",
          "level",
          "eliteKills",
          "maxDepthReached",
          "bestDepth",
          "extractedGeek",
          "extractMode",
          "extractionSucceeded",
          "startDepth",
          "usedDepthRelay",
          "anjuMemoryEarned",
          "selectedTitle",
          "selectedBadge",
          "submittedAt",
          "version",
          "uid",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 100000
        && request.resource.data.survivalTimeMs is int
        && request.resource.data.survivalTimeMs >= 0
        && request.resource.data.survivalTimeMs <= 86400000
        && request.resource.data.level is int
        && request.resource.data.level >= 0
        && request.resource.data.level <= 999
        && request.resource.data.eliteKills is int
        && request.resource.data.eliteKills >= 0
        && request.resource.data.eliteKills <= 100000
        && (!request.resource.data.keys().hasAny(["maxDepthReached"])
          || (request.resource.data.maxDepthReached is int
            && request.resource.data.maxDepthReached >= 1
            && request.resource.data.maxDepthReached <= 999))
        && (!request.resource.data.keys().hasAny(["bestDepth"])
          || (request.resource.data.bestDepth is int
            && request.resource.data.bestDepth >= 1
            && request.resource.data.bestDepth <= 999))
        && (!request.resource.data.keys().hasAny(["extractedGeek"])
          || (request.resource.data.extractedGeek is int
            && request.resource.data.extractedGeek >= 0
            && request.resource.data.extractedGeek <= 1000000000))
        && (!request.resource.data.keys().hasAny(["extractMode"])
          || (request.resource.data.extractMode is string
            && request.resource.data.extractMode in ["none", "normal", "emergency"]))
        && (!request.resource.data.keys().hasAny(["extractionSucceeded"])
          || request.resource.data.extractionSucceeded is bool)
        && (!request.resource.data.keys().hasAny(["startDepth"])
          || (request.resource.data.startDepth is int
            && request.resource.data.startDepth >= 1
            && request.resource.data.startDepth <= 999
            && request.resource.data.keys().hasAny(["bestDepth"])
            && request.resource.data.startDepth <= request.resource.data.bestDepth))
        && (!request.resource.data.keys().hasAny(["usedDepthRelay"])
          || request.resource.data.usedDepthRelay is bool)
        && (!request.resource.data.keys().hasAny(["usedDepthRelay"])
          || request.resource.data.usedDepthRelay == false
          || (request.resource.data.keys().hasAny(["startDepth"])
            && (request.resource.data.startDepth == 10
              || request.resource.data.startDepth == 20
              || request.resource.data.startDepth == 30)
            && request.resource.data.keys().hasAny(["bestDepth"])
            && request.resource.data.bestDepth >= request.resource.data.startDepth))
        && (!request.resource.data.keys().hasAny(["anjuMemoryEarned"])
          || (request.resource.data.anjuMemoryEarned is int
            && request.resource.data.anjuMemoryEarned >= 0
            && request.resource.data.anjuMemoryEarned <= 100000))
        && (!request.resource.data.keys().hasAny(["selectedTitle"])
          || (request.resource.data.selectedTitle is string
            && request.resource.data.selectedTitle.size() <= 32))
        && (!request.resource.data.keys().hasAny(["selectedBadge"])
          || (request.resource.data.selectedBadge is string
            && request.resource.data.selectedBadge.size() <= 12))
        && (!request.resource.data.keys().hasAny(["submittedAt"])
          || (request.resource.data.submittedAt is int
            && request.resource.data.submittedAt >= 0))
        && (!request.resource.data.keys().hasAny(["version"])
          || (request.resource.data.version is int
            && request.resource.data.version >= 1
            && request.resource.data.version <= 10))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
